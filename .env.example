# ─────────────────────────────────────────────
# cfox-local Environment Variables
# ─────────────────────────────────────────────

# Base directory for profiles (default: ~/.cfox)
# CFOX_BASE_DIR=~/.cfox

# Local server port
# CFOX_PORT=7600

# Local server host
# CFOX_HOST=127.0.0.1

# Cloud server connection (optional)
# CFOX_SERVER_URL=http://your-server:8700
# CFOX_SERVER_API_KEY=your-api-key-here

# ─────────────────────────────────────────────
# cfox-server Environment Variables
# ─────────────────────────────────────────────

# PostgreSQL password (CHANGE THIS!)
POSTGRES_PASSWORD=cfox_secure_password

# PostgreSQL connection URL
# DATABASE_URL=postgresql+asyncpg://cfox:cfox_secure_password@localhost:5432/cfox

# Essential data storage directory
# STORAGE_DIR=data/essential_data

# Server bind settings
# HOST=0.0.0.0
# PORT=8700

# Lock settings
# LOCK_TTL_MINUTES=120
# LOCK_CLEANUP_INTERVAL_SECONDS=60

# Version retention
# MAX_VERSIONS=3

# Admin API key (optional — if empty, one is auto-generated on first start)
# ADMIN_API_KEY=your-secure-api-key-here

# Server port exposed to host (Docker Compose)
SERVER_PORT=8700
