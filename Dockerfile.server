FROM python:3.12-slim

WORKDIR /app

# Install system deps for asyncpg + git + curl (Playwright source build needs curl)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy project files
COPY pyproject.toml README.md ./
COPY src/ src/
COPY cfox_server/ cfox_server/

# Step 1: Install stable Playwright wheel first to avoid source-build SSL issue
# (See README — Manual install steps).
RUN pip install --no-cache-dir playwright==1.52.0

# Step 2: Install with server extras (Playwright wheel will be picked up).
RUN pip install --no-cache-dir -e ".[server]"

# Create data directory
RUN mkdir -p /app/data/essential_data

# Expose port
EXPOSE 8700

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import httpx; r = httpx.get('http://localhost:8700/api/health'); r.raise_for_status()" || exit 1

# Run server
CMD ["python", "-m", "cfox_server"]
